# Copy this file to `.env` and fill in the values (see README "Environment" section).
# Public values — safe to expose, baked into the site at build time:
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Server-only values — NEVER prefix with VITE_, set in Render dashboard:
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY="sb_secret_... (Supabase Dashboard → Settings → API → service_role)"
LOVABLE_API_KEY="(optional) Lovable AI gateway key — only needed for admin PDF menu import"

# Deploy override (Render sets this via render.yaml, you don't need it locally):
# NITRO_PRESET="node-server"
